          "exercises/05-concurrency/06-channels/05-broadcast/Cargo.toml",
          "exercises/06-debug/02-cargo-and-tools/01-missing-dependency/Cargo.toml",
          "exercises/06-debug/02-cargo-and-tools/02-toolbox-hunt/Cargo.toml",
