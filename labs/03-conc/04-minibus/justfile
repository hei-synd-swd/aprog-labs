set windows-shell := ["wsl", "bash", "-lic"]

_default:
    @just --list

# 8 unit tests
test:
    cargo test

# rustfmt + curated clippy, zero warnings
lint:
    cargo fmt --check
    cargo clippy --all-targets -- -D warnings

# fan-out + drop-unsubscribe walkthrough
demo:
    cargo run --example basic

# listener vs subscriber: who pays the cost?
listener:
    cargo run --example listener

# TCP chat between two terminals: `just chat listen 7878`, then `just chat connect 127.0.0.1:7878`
chat *args:
    cargo run --example chat -- {{args}}