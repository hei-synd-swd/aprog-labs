##################################################
# Prime Tasks - std::thread spawn/join Lab
#

set shell := ["bash", "-uc"]
set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

# grep -E equivalent on Windows (same regex syntax)
grep := if os_family() == "windows" { "Select-String -CaseSensitive" } else { "grep -E" }

# List all commands
default:
  just --list

# Run the parallel prime counter on the data file
@run:
  cargo run --release

# Benchmark sequential vs parallel
@bench:
  cargo run --release -- bench

# Run all tests (single-threaded so output stays grouped by module)
@test:
  cargo test -- --test-threads=1

# Run tests, showing only failures
@test-quiet:
  cargo test 2>&1 | {{grep}} "(test |FAILED|error|panic)"

# Check that the project compiles
@check:
  cargo check

# Format code
@fmt:
  cargo fmt

# Run clippy
@lint:
  cargo clippy
