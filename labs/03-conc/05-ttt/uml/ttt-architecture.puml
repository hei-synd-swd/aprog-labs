@startuml
skinparam shadowing false
skinparam ArrowColor black
skinparam nodesep 70
skinparam ranksep 60
skinparam linetype ortho
skinparam defaultTextAlignment center
skinparam component {
  BackgroundColor #E8F4FD
  BorderColor #2196F3
  FontColor #1565C0
}
skinparam queue {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
}
skinparam rectangle {
  BackgroundColor white
  BorderColor #90A4AE
  FontColor #455A64
}
' instrument CLASSES (owned by a component, never on the bus) are
' white cards — visually apart from the blue bus components
skinparam card {
  BackgroundColor white
  BorderColor #90A4AE
  FontColor #455A64
}

title ttt — architecture · two executables · protocol v3.0

' CONVENTION: inside each box, the channels form a side-by-side RAIL
' beneath the components that use them — the bus reads like a bus.

rectangle "**server** — the authority (one game per run)" as srv {
  component "SessionController — PURE\nhandle → addressed replies" as sctl
  card "«class» Game" as mdl
  sctl -left- mdl : owns
  ' the M of the MVC-across-the-wire reading (prose in the READMEs);
  ' clients re-derive locals per push — no replica

  rectangle "minibus" as sbus #line.dashed {
    queue "inbox\n(Player, Request)" as inbox
    queue "updates\n(To, Update)" as updates
    ' the rail: channels side by side
    inbox -[hidden]right- updates
  }

  component "net\nseats X then O, by arrival\neach writer filters its seat" as plumb

  inbox -up-> sctl : dispatch\n(serve)
  sctl -down-> updates : replies
  plumb -up-> inbox : publish
  updates -down-> plumb : writers filter\nper seat
}

rectangle "**player** — a human at a keyboard\nmain wires it up and dispatches to the controller" as ply {
  component "controller\ndecides what to do" as ctl
  card "«class» ConsoleDisplay" as disp
  ctl -right- disp : owns
  ' the V of the reading: off the bus, injected at creation —
  ' the front swap point (TUI / GUI)

  rectangle "minibus" as pbus #line.dashed {
    queue "events\n(Start · FromStdin · FromServer · Closed)" as ev
    queue "outgoing\nRequest" as outq
    ' the rail: channels side by side
    outq -[hidden]right- ev
  }

  component "input\nstdin source (user side)" as inp
  component "net\nconnect + reader/writer\n(wire side)" as pnet

  ' the brain above the rail; the UI column top-right (display over
  ' input); net alone below, on the LEFT, facing the server's net
  ' across the TCP edge
  disp -[hidden]down- inp

  ev -up-> ctl : sole consumer\n(the dispatcher)
  ctl -down-> outq : requests
  inp -down-> ev : publish\nlines
  pnet -up-> ev : publish\nupdates
  outq -down-> pnet : net writer\ndrains
}

component "netcat probe\nthe zero-code peer (e2e)" as probe

plumb <-right-> pnet : TCP (one line per message)
probe .up.> plumb : speaks the\nsame lines
note right of probe
  the dialect, raw — one line per message:
  HELLO · SEAT X · MOVE 5 · REFUSED taken · BYE
  no seat on the wire: the socket IS the address
end note
' anchor the probe right under the server box
plumb -[hidden]down- probe

' The long form of both truths lives in the READMEs: the clients are
' thin (no game logic client-side — legality is the server's), and the
' reply rule enumerates HELLO→SEAT+board, STATE→board, bad MOVE→REFUSED.
note bottom of ply
  clients are THIN — no game logic here. Reply rule:
  a question is ANSWERED, a change is BROADCAST.
end note

' (cross-references live in the READMEs — no legend banner in the graph)

@enduml
