@startuml
skinparam shadowing false
skinparam ArrowColor black
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam classBorderColor black
hide circle
skinparam nodesep 90
skinparam ranksep 75
skinparam linetype ortho

'--- One neutral style for every box: this is a CONTRACT, not an implementation ---
skinparam class {
  BackgroundColor #E8F4FD
  BorderColor #2196F3
  FontColor #1565C0
  AttributeFontColor black
}
skinparam package {
  BorderColor #90A4AE
  FontColor #455A64
}

title ttt — classes (shared contract Rust ⟷ Qt) · protocol v3.0

'==================== server ====================
package "server — the authority" as srvpkg {

  class "server" as srvrun <<utility>> {
      + run(listener)
  }

  class "net" as srvnet <<utility>> {
      + accept_loop(listener, inbox, seat_x, seat_o, writers)
      - reader_loop(seat, stream, inbox)
      - writer_loop(seat, stream, updates)
  }

  enum To {
      Everyone
      Seat { player }
  }

  class SessionController {
      - game : Game
      - finished : bool
      + handle(seat, request) : (To, Update) [*]
      + finished() : bool
  }
}

'==================== core ====================
package "core — the protocol contract (no network, no bus)" {

  enum Request {
      Hello
      Move { cell }
      GetBoard
      Bye
  }

  enum Update {
      Seat { player }
      Board { cells }
      Refused { refusal }
      Bye
  }

  enum Refusal {
      WrongTurn
      Rule { error }
  }

  enum PlayError {
      OutOfRange
      CellTaken
      GameOver
  }

  class "wire" as wire <<utility>> {
      + encode_request(request) : String
      + decode_request(line) : Request?
      + encode_update(update) : String
      + decode_update(line) : Update?
  }

  class Game {
      - board : Player?[9]
      - turn : Player
      - state : State
      + play(n) : PlayError?
      + turn() : Player
      + state() : State
      - cell(n) : Player?
      + free_cells() : n [*]
      + verdict() : String?
      + wire_state() : String
      + {static} from_wire_state(s) : Game?
  }

  enum Player {
      X
      O
  }
  enum State {
      Playing
      Won { player, line }
      Draw
  }

  Update ..> Refusal
  Refusal ..> PlayError : wraps
}

'==================== player ====================
package "player — a human at a keyboard" as plypkg {

  class "main" as plyrun <<utility>> {
      + main()
      - parse_args() : addr
  }

  class "input" as plyinput <<utility>> {
      + spawn_stdin(events)
  }

  class "net" as plynet <<utility>> {
      + connect(addr) : socket?
      + spawn_net_reader(events, socket)
      + spawn_net_writer(outgoing, socket)
  }

  enum Event {
      Start
      FromStdin { text }
      FromServer { update }
      Closed
  }

  class Controller {
      - display : ConsoleDisplay
      - leaving : bool
      - done : bool
      + handle(event) : Request [*]
      + finished() : bool
      - decode(line) : Request?
  }

  class ConsoleDisplay {
      - me : Player?
      - playing : bool
      + on_update(update, leaving)
  }

  Controller "1" *-- "1" ConsoleDisplay : owns its screen
  Event ..> Update
}

'--- only what the boxes cannot say: ownership, replay, the swap point ---
srvnet ..> wire : <<use>>
srvnet ..> To : <<use>> each writer keeps\nwhat is for its seat
plynet ..> wire : <<use>>
plyrun ..> Controller : <<create>>
SessionController "1" *-- "1" Game : owns THE game
' The display re-derives a LOCAL Game per pushed board — nothing
' stored: the terminal is the replica (see the READMEs).
ConsoleDisplay ..> Game : <<use>> a LOCAL\nper push

' The SessionController is the one AUTHORITY over the session (role name in the
' prose); the full reply-rule enumeration lives in the READMEs.
note as ReplyNote
  reply.to = request.seat; changes broadcast.
  No clock anywhere.
end note
SessionController .. ReplyNote

' (reading key & cross-references live in the READMEs — no banner in the graph)


@enduml
