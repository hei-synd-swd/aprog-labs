##################################################
# Human vs. Zombie - OOP Lab
#

set shell := ["bash", "-uc"]
set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

# grep -E equivalent on Windows (same regex syntax)
grep := if os_family() == "windows" { "Select-String -CaseSensitive" } else { "grep -E" }
part := "part1"

# List all commands
default:
  just --list

# Run the game
@run:
  cargo run

# Run all tests with part selection [part1|part2] (single-threaded so output stays grouped by module)
@test part=part:
  cargo test --features="{{part}}" -- --test-threads=1

# Run tests, showing only failures
@test-quiet part=part:
  cargo test --features="{{part}}" 2>&1 | {{grep}} "(test |FAILED|error|panic)"

# Check that the project compiles
@check:
  cargo check

# Format code
@fmt:
  cargo fmt

# Run clippy
@lint:
  cargo clippy
